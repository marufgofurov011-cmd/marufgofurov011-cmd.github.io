<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kalkulyator</title>
<style>
  :root {
    --bg: #e9efe9;
    --body: #1f3a34;
    --screen: #f3f7f1;
    --screen-text: #14251f;
    --key: #2c4d45;
    --key-text: #eef5ee;
    --op: #4b7a6d;
    --accent: #e8b53a;
    --accent-text: #2a2000;
    --clear: #b4503c;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #101a17;
      --body: #1b2f2a;
      --screen: #cfdccb;
      --screen-text: #11201b;
      --key: #274640;
      --op: #3f6a5e;
    }
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body {
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Trebuchet MS", "Segoe UI", sans-serif;
    padding: 16px;
  }
  .calc {
    background: var(--body);
    width: 100%;
    max-width: 340px;
    padding: 18px;
    border-radius: 22px;
    box-shadow: 0 18px 40px rgba(0,0,0,.25);
  }
  .screen {
    background: var(--screen);
    color: var(--screen-text);
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 16px;
    text-align: right;
    min-height: 92px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }
  .history { font-size: 14px; opacity: .6; min-height: 20px; word-break: break-all; }
  .value { font-size: 38px; font-weight: 700; word-break: break-all; line-height: 1.2; }
  .keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  button {
    border: 0;
    border-radius: 12px;
    padding: 0;
    height: 60px;
    font-size: 22px;
    font-family: inherit;
    background: var(--key);
    color: var(--key-text);
    cursor: pointer;
    transition: transform .08s, filter .15s;
  }
  button:hover { filter: brightness(1.15); }
  button:active { transform: scale(.94); }
  button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .op { background: var(--op); }
  .clear { background: var(--clear); }
  .eq { background: var(--accent); color: var(--accent-text); font-weight: 700; grid-row: span 2; height: auto; }
  .zero { grid-column: span 2; }
  @media (prefers-reduced-motion: reduce) { button { transition: none; } }
</style>
</head>
<body>
  <main class="calc" aria-label="Kalkulyator">
    <div class="screen" aria-live="polite">
      <div class="history" id="history"></div>
      <div class="value" id="value">0</div>
    </div>
    <div class="keys">
      <button class="clear" data-act="clear">C</button>
      <button class="op" data-act="back" aria-label="O'chirish">⌫</button>
      <button class="op" data-act="percent">%</button>
      <button class="op" data-op="/">÷</button>

      <button data-num="7">7</button>
      <button data-num="8">8</button>
      <button data-num="9">9</button>
      <button class="op" data-op="*">×</button>

      <button data-num="4">4</button>
      <button data-num="5">5</button>
      <button data-num="6">6</button>
      <button class="op" data-op="-">−</button>

      <button data-num="1">1</button>
      <button data-num="2">2</button>
      <button data-num="3">3</button>
      <button class="op" data-op="+">+</button>

      <button class="zero" data-num="0">0</button>
      <button data-act="dot">.</button>
      <button class="eq" data-act="equals">=</button>
    </div>
  </main>

<script>
  let current = "0";
  let prev = null;
  let operator = null;
  let fresh = false;

  const valueEl = document.getElementById("value");
  const historyEl = document.getElementById("history");
  const sym = { "+": "+", "-": "−", "*": "×", "/": "÷" };

  function render() {
    valueEl.textContent = current;
    historyEl.textContent = operator ? prev + " " + sym[operator] : "";
  }

  function compute(a, b, op) {
    a = parseFloat(a); b = parseFloat(b);
    let r;
    if (op === "+") r = a + b;
    else if (op === "-") r = a - b;
    else if (op === "*") r = a * b;
    else if (op === "/") {
      if (b === 0) return "Nolga bo'lib bo'lmaydi";
      r = a / b;
    }
    return String(parseFloat(r.toPrecision(12)));
  }

  function inputNum(n) {
    if (fresh || current === "0" || isNaN(current)) { current = n; fresh = false; }
    else if (current.length < 15) current += n;
    render();
  }

  function inputOp(op) {
    if (isNaN(current)) return;
    if (operator && !fresh) {
      current = compute(prev, current, operator);
      if (isNaN(current)) { operator = null; prev = null; render(); fresh = true; return; }
    }
    prev = current;
    operator = op;
    fresh = true;
    render();
  }

  function equals() {
    if (!operator || isNaN(current)) return;
    const result = compute(prev, current, operator);
    historyEl.textContent = prev + " " + sym[operator] + " " + current + " =";
    current = result;
    operator = null;
    prev = null;
    fresh = true;
    valueEl.textContent = current;
  }

  function act(a) {
    if (a === "clear") { current = "0"; prev = null; operator = null; fresh = false; }
    else if (a === "back") {
      if (isNaN(current) || fresh) current = "0";
      else current = current.length > 1 ? current.slice(0, -1) : "0";
    }
    else if (a === "dot") {
      if (fresh || isNaN(current)) { current = "0."; fresh = false; }
      else if (!current.includes(".")) current += ".";
    }
    else if (a === "percent") {
      if (!isNaN(current)) current = String(parseFloat((parseFloat(current) / 100).toPrecision(12)));
    }
    else if (a === "equals") { equals(); return; }
    render();
  }

  document.querySelector(".keys").addEventListener("click", function (e) {
    const b = e.target.closest("button");
    if (!b) return;
    if (b.dataset.num !== undefined) inputNum(b.dataset.num);
    else if (b.dataset.op) inputOp(b.dataset.op);
    else if (b.dataset.act) act(b.dataset.act);
  });

  document.addEventListener("keydown", function (e) {
    if (/^[0-9]$/.test(e.key)) inputNum(e.key);
    else if (["+", "-", "*", "/"].includes(e.key)) inputOp(e.key);
    else if (e.key === "Enter" || e.key === "=") { e.preventDefault(); equals(); }
    else if (e.key === ".") act("dot");
    else if (e.key === "Backspace") act("back");
    else if (e.key === "Escape") act("clear");
    else if (e.key === "%") act("percent");
  });

  render();
</script>
</body>
</html>